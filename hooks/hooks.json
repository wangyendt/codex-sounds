{
  "description": "Passive macOS, Linux and Windows sounds; no approval decisions or continuation outputs.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/run.sh\"",
            "timeout": 8,
            "commandWindows": "python -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'scripts','notify.py'),run_name='__main__')\""
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/run.sh\"",
            "timeout": 8,
            "commandWindows": "python -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'scripts','notify.py'),run_name='__main__')\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "(^|[.__])(request_user_input(_async)?|AskUserQuestion)$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/run.sh\"",
            "timeout": 8,
            "commandWindows": "python -X utf8 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'scripts','notify.py'),run_name='__main__')\""
          }
        ]
      }
    ]
  }
}
